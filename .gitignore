# ============================================================
# Unity 6 (6000.x) — 저장소 루트 = Unity 프로젝트 루트
#
# 기준: github/gitignore 의 Unity.gitignore
#   https://github.com/github/gitignore/blob/main/Unity.gitignore
# 선행 '/'는 "루트에서만 매칭"을 뜻한다. Assets/ 안의 동명 폴더는 보호된다.
# ============================================================

# --- Unity가 자동 생성하는 폴더 (Library는 수 GB) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Pp]rofiler[Cc]aptures/
.utmp/
*.log

# --- meta 파일은 어떤 규칙에도 걸리지 않게 보호한다 ---
# GUID가 빠지면 씬·프리팹의 참조가 전부 끊어진다.
!/[Aa]ssets/**/*.meta

# --- Burst 디버그 산출물 ---
/[Bb]urst[Dd]ebug[Ii]nformation_*/

# --- Addressables 빌드 산출물 (원본 에셋은 커밋된다) ---
/ServerData/
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/Addressables_Temp*

# --- 에디터가 Assets 안에 만드는 캐시 / 자동 생성물 ---
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
/UIElementsSchema/

# --- 테스트 러너가 만드는 임시 씬 ---
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
InitTestScene*.unity*

# --- Blender 백업본 ---
*.blend1
*.blend1.meta

# --- 빌드 결과물 ---
# 실행 파일(*.exe 등)은 확장자로 무시하지 않는다. Assets 안의 외부 도구까지
# 조용히 삼키기 때문이다. 빌드는 위의 /Build/ 규칙으로 이미 걸러진다.
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# --- IDE / 솔루션 파일 (Unity가 asmdef로부터 재생성한다) ---
ExportedObj/
.consulo/
.vs/
.idea/
.vscode/
.gradle/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# 위에서 무시한 파일의 짝 meta. 없으면 고아 meta가 커밋된다.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- 크래시 로그 ---
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# ============================================================
# 반드시 커밋해야 하는 것 (실수로 무시하지 말 것)
#   Assets/          모든 에셋과 스크립트
#   *.meta           Unity가 파일을 식별하는 GUID
#   ProjectSettings/ 프로젝트 설정
#   Packages/        manifest.json · packages-lock.json (패키지 버전 고정)
# ============================================================
