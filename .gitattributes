# --- 확장자는 텍스트지만 내용이 바이너리 덩어리인 것들 ---
# 아래 두 줄은 위의 YAML 규칙을 덮어쓴다. 뒤에 오는 규칙이 이긴다.
LightingData.asset filter=lfs diff=lfs merge=lfs -text
NavMesh.asset      filter=lfs diff=lfs merge=lfs -text
# .scenetemplate 은 YAML이지만 텍스처가 통째로 박혀 파일 하나가 수 MB다.
*.scenetemplate    filter=lfs diff=lfs merge=lfs -text
